NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

CRON_SECRET=your-cron-secret-here

# Remove this variable to make the site public
SITE_PASSWORD=your-staging-password-here

# Email notifications (G1) — leave unset to disable sending (sends are logged and skipped)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Kanto Keepsakes <notifications@kantokeepsakes.com>"

# Mobile client key (M0/B2) — embedded in the app; signup requests carrying it
# skip Turnstile and get a stricter rate limit instead
MOBILE_CLIENT_KEY=your-mobile-client-key

# Redis rate limiting (B7) — Upstash REST credentials; leave unset to fall back
# to the per-instance in-memory limiter (fine for dev, not for production scale)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
